{% extends "_base.html.j2" %}
{% import "_macros.j2" as m %}

{% set p = profile %}
{% set ff = p.four_factors %}

{% block title %}{{ p.identity.name }} tournament report{% endblock %}
{% block eyebrow %}{{ event_name }} &middot; Tournament to date{% endblock %}
{% block heading %}{{ flag(p.identity.code, 24) }}{{ p.identity.name }}{% endblock %}
{% block subtitle %}
{{ p.wins }}&ndash;{{ p.losses }} over {{ p.games_played }} game{{ '' if p.games_played == 1 else 's' }}
&middot; {{ '%.1f'|format(p.points_for_pg or 0) }} scored, {{ '%.1f'|format(p.points_against_pg or 0) }} allowed per game
&middot; Updated after every result
{% endblock %}
{% block footid %}{{ p.identity.name }} tournament report{% endblock %}

{% block content %}

{{ m.sample_banner(p.games_played) }}

<section class="keep">
<h2>Where we stand</h2>
<div class="statline">
  {{ m.stat('Record', '%d&ndash;%d'|format(p.wins, p.losses),
            '%d games'|format(p.games_played)) }}
  {{ m.stat('Off rating', '%.1f'|format(ff.off_rating or 0), 'per 100 poss') }}
  {{ m.stat('Def rating', '%.1f'|format(ff.def_rating or 0), 'per 100 poss') }}
  {{ m.stat('Net', '%+.1f'|format(ff.net_rating or 0),
            m.rank_note(ranks, 'net_rating') or 'per 100 poss',
            'pos' if (ff.net_rating or 0) > 0 else 'neg') }}
  {{ m.stat('Pace', '%.1f'|format(p.pace or 0),
            m.rank_note(ranks, 'pace', 'fastest ') or 'poss/game') }}
</div>
</section>

<section>
<h2>Team box score</h2>
{{ m.team_box(box_rows, per_game=True, caption='Per game') }}
{{ m.scoring_share(box_rows, per_game=True) }}
</section>

<section class="keep">
<h2>Four factors, all games</h2>
{{ m.four_factor_table(ff, p.opp_four_factors, league, p.identity.code, 'Opponents', ranks=ranks) }}
{{ charts.four_factors }}
</section>

<section>
<h2>Game by game</h2>
{{ m.game_log(p.games, "ireland-log", totals={"own": ff, "opp": p.opp_four_factors, "pace": p.pace, "record": "%d&ndash;%d"|format(p.wins, p.losses)}) }}
</section>

<section>
<h2>Players, tournament to date</h2>
{{ m.player_table(players, per_game=True, details=player_details,
                  scope='all games') }}
</section>

<section class="keep">
<h2>Shooting</h2>
<div class="chartpair">
  <div>
    <h3>Shots {{ p.identity.name }} took</h3>
    {{ charts.shots }}
    {{ m.zone_table(zones, caption='') }}
  </div>
  <div>
    <h3>Shots {{ p.identity.name }} allowed</h3>
    {{ charts.shots_faced }}
    {{ m.zone_table(faced_zones, caption='') }}
  </div>
</div>
<p class="note">Where a team lets opponents shoot from is the clearest read on
their defence: a high rim share means the paint is open, a high three share
means they run shooters off the line but concede space outside.</p>
</section>

<section>
<h2>Most-used lineups</h2>
{% if lineups_available %}
{{ m.lineup_table(lineups, 'Aggregated across the tournament') }}
{% else %}
<p class="banner alert">Lineup data is withheld: reconstruction did not pass
validation for these games.</p>
{% endif %}
</section>

{% endblock %}

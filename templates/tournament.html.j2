{# Ireland's own page. Deliberately the same shape, the same sections and the
   same ranked stat strip as an opponent scouting sheet, so staff read their own
   team on exactly the terms they read everyone else. #}
{% extends "_base.html.j2" %}
{% import "_macros.j2" as m %}

{% set p = profile %}
{% set ff = p.four_factors %}
{% set off = p.opp_four_factors %}

{% block title %}{{ p.identity.name }} tournament report{% endblock %}
{% block eyebrow %}{{ event_name }} &middot; Tournament to date{% endblock %}
{% block kickerright %}{{ generated_at }}{% endblock %}
{% block heading %}{{ flag(p.identity.code, 24) }}{{ p.identity.name }}{% endblock %}
{% block subtitle %}
{{ p.wins }}&ndash;{{ p.losses }} over {{ p.games_played }} game{{ '' if p.games_played == 1 else 's' }}
&middot; {{ '%.1f'|format(p.points_for_pg or 0) }} scored, {{ '%.1f'|format(p.points_against_pg or 0) }} allowed per game
&middot; Net {{ '%+.1f'|format(ff.net_rating or 0) }} per 100
{% endblock %}
{% block footid %}{{ p.identity.name }} tournament report{% endblock %}

{% block content %}

{{ m.sample_banner(p.games_played, 'This profile is built from data that') }}

<section class="keep">
<h2>Profile</h2>
<div class="statline">
  {{ m.stat('Record', '%d&ndash;%d'|format(p.wins, p.losses),
            '%d games'|format(p.games_played)) }}
  {{ m.stat_ranked('Off rating', '%.1f'|format(ff.off_rating or 0),
                   ranks, 'off_rating', 'per 100 poss') }}
  {{ m.stat_ranked('Def rating', '%.1f'|format(ff.def_rating or 0),
                   ranks, 'def_rating', 'per 100 poss') }}
  {{ m.stat_ranked('Net', '%+.1f'|format(ff.net_rating or 0),
                   ranks, 'net_rating', 'per 100 poss',
                   'pos' if (ff.net_rating or 0) > 0 else 'neg') }}
  {{ m.stat_ranked('Pace', '%.1f'|format(p.pace or 0),
                   ranks, 'pace', 'poss/game', qualifier='fastest') }}
  {{ m.stat_ranked('3PT rate', '%.1f%%'|format(ff.fg3_rate or 0),
                   ranks, 'fg3_rate', 'of shots', qualifier='highest') }}
</div>
<p class="note">Shading marks where Ireland sit in the event: blue is good, red
is poor, and pace and three-point rate carry a rank but no shading, because
playing fast or shooting a lot of threes is a style rather than an achievement.</p>
</section>

<section>
<h2>Team box score</h2>
{{ m.team_box(box_rows, per_game=True, caption='Per game') }}
</section>

<section class="keep">
<h2>Four factors</h2>
{{ m.four_factor_ranked(ff, off, league, ranks, p.identity.code, 'ff-table') }}
{{ charts.four_factors }}
</section>

<section>
<h2>How we score</h2>
{{ m.scoring_share(box_rows, per_game=True, ranks=ranks, table_id='scoring') }}
</section>

<section class="keep">
<h2>Shooting</h2>
{{ m.rank_toggle('table.zones') }}
<div class="chartpair">
  <div>
    <h3>Shots {{ p.identity.name }} took</h3>
    {{ charts.shots }}
    {{ m.zone_table(zones, caption='', ranks=ranks, klass='zones') }}
  </div>
  <div>
    <h3>Shots {{ p.identity.name }} allowed</h3>
    {{ charts.shots_faced }}
    {{ m.zone_table(faced_zones, caption='', ranks=ranks, prefix='opp_',
                    klass='zones') }}
  </div>
</div>
<p class="note">Where a team lets opponents shoot from is the clearest read on
their defence: a high rim share means the paint is open, a high three share
means they run shooters off the line but concede space outside. Shading follows
what a shot is worth in this event, where the rim returns 1.14 points an attempt
against an all-shots average of 0.89 and mid-range returns 0.61. Rim and
mid-range volume are therefore shaded on both sides of the ball; paint, corner,
wing and top all return between 0.73 and 0.81, so those shares carry a rank but
no colour rather than a distinction the numbers do not support.</p>
</section>

<section>
<h2>Personnel</h2>
{{ m.player_table(players, per_game=True, details=player_details,
                  scope='all games', pcts=percentiles, table_id='players') }}
<p class="note">Sorted by minutes. USG% is the share of team possessions a player
uses while on court. FD/40 flags who draws fouls.</p>
</section>

<section>
<h2>Lineups</h2>
{% if lineups_available %}
{{ m.lineup_table(lineups, 'Aggregated across the tournament') }}
{% else %}
<p class="banner alert">Lineup reconstruction did not pass validation for these
games, so lineup figures are withheld rather than shown unverified.</p>
{% endif %}
</section>

<section>
<h2>Game log</h2>
{{ m.game_log(p.games, "ireland-log", totals={"own": ff, "opp": p.opp_four_factors, "pace": p.pace, "record": "%d&ndash;%d"|format(p.wins, p.losses)}) }}
</section>

{% endblock %}

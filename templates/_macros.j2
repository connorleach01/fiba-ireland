{# Shared fragments for the printed report layout. #}

{% macro num(value, digits=1, suffix='') -%}
{%- if value is none -%}<span class="muted">&ndash;</span>
{%- else -%}{{ '%.*f'|format(digits, value) }}{{ suffix }}{%- endif -%}
{%- endmacro %}

{% macro signed(value, digits=1) -%}
{%- if value is none -%}<span class="muted">&ndash;</span>
{%- else -%}{{ '%+.*f'|format(digits, value) }}{%- endif -%}
{%- endmacro %}

{# Colour a cell by sign, but never colour a value we chose not to publish. #}
{% macro tone(value) -%}
{%- if value is none -%}{%- elif value > 0 -%}pos{%- elif value < 0 -%}neg{%- endif -%}
{%- endmacro %}

{# One cell of a ruled stat strip. Use inside {% call %} or a .statline div. #}
{% macro stat(label, figure, sub='', klass='') %}
<div class="stat">
  <div class="label">{{ label }}</div>
  <div class="figure {{ klass }}">{{ figure }}</div>
  {% if sub %}<div class="sub">{{ sub }}</div>{% endif %}
</div>
{% endmacro %}

{# A stat-strip cell tinted by where the team ranks, with the rank printed
   underneath. Unlike the tables this needs no toggle: the strip is the page's
   headline and carries six figures, not sixty. Metrics with no better/worse
   direction get the rank but no tint. #}
{% macro stat_ranked(label, figure, ranks, key, fallback='', klass='',
                     qualifier='') %}
{%- set r = (ranks or {}).get(key) -%}
<div class="stat{% if r and r.tier %} t{{ r.tier }}{% endif %}">
  <div class="label">{{ label }}</div>
  <div class="figure {{ klass }}">{{ figure }}</div>
  <div class="sub">
    {%- if not r %}{{ fallback }}
    {%- elif qualifier %}{{ ordinal_short(r.rank) }} {{ qualifier }} of {{ r.of }}
    {%- else %}{{ r.label }}{% endif -%}
  </div>
</div>
{% endmacro %}

{# A table cell carrying a value plus its standing, shaded by tier when the
   reader turns ranks on. Metrics with no better/worse direction get a standing
   but no tier, so style is never coloured as if it were quality.

   `pct` picks how the chip reads. Twenty-two teams rank naturally, so a team
   table shows "3rd". Two hundred and sixty-four players do not: "254th" is hard
   to place and reads as a mistake next to a button offering percentiles, so a
   player table shows the percentile, 100 being the top of the field. The rank
   is still there on hover. #}
{% macro rk(value, ranks, key, digits=1, plus=False, pct=False) -%}
{%- set r = (ranks or {}).get(key) -%}
<td class="{% if r and r.tier %}t{{ r.tier }}{% endif %}">
{%- if plus %}{{ signed(value, digits) }}{% else %}{{ num(value, digits) }}{% endif -%}
{%- if r %}
  {%- if pct %}<span class="rk-chip" title="{{ ordinal_short(r.rank) }} of {{ r.of }}">{{ '%.0f'|format(r.percentile) }}</span>
  {%- else %}<span class="rk-chip">{{ ordinal_short(r.rank) }}</span>{% endif -%}
{%- endif -%}
</td>
{%- endmacro %}

{% macro ordinal_short(n) -%}
{%- if 10 <= n % 100 <= 20 %}{{ n }}th
{%- elif n % 10 == 1 %}{{ n }}st{% elif n % 10 == 2 %}{{ n }}nd
{%- elif n % 10 == 3 %}{{ n }}rd{% else %}{{ n }}th{% endif -%}
{%- endmacro %}

{% macro rank_toggle(target, off='Show ranks', on='Hide ranks') %}
<button type="button" class="ranktoggle no-print" data-target="{{ target }}"
        data-off="{{ off }}" data-on="{{ on }}" aria-pressed="false">{{ off }}</button>
{% endmacro %}

{% macro sample_banner(games_played, thing='These figures') %}
{% if games_played <= 2 %}
<p class="banner alert"><strong>Small sample.</strong> {{ thing }} come from
{{ games_played }} game{{ '' if games_played == 1 else 's' }}. Treat as indicative
only and weight recent film over the numbers.</p>
{% elif games_played <= 4 %}
<p class="banner"><strong>Limited sample:</strong> {{ games_played }} games.
Rate stats are still noisy at this stage of the tournament.</p>
{% endif %}
{% endmacro %}

{% macro player_table(players, per_game=True, caption='', details=None, scope='',
                      pcts=None, table_id='players') %}
{% if pcts %}{{ rank_toggle('#' ~ table_id, 'Show percentiles', 'Hide percentiles') }}{% endif %}
<div class="scroll-x">
<table id="{{ table_id }}" class="{{ 'expandable' if details else '' }}">
{% if caption %}<caption>{{ caption }}</caption>{% endif %}
<thead>
  <tr>
    <th class="left">#</th><th class="left" data-sortable>Player</th>
    {% if per_game %}
      <th data-sortable>GP</th><th data-sortable>MPG</th><th data-sortable>PPG</th>
      <th data-sortable>RPG</th><th data-sortable>APG</th>
    {% else %}
      <th data-sortable>MIN</th><th data-sortable>PTS</th><th data-sortable>REB</th>
      <th data-sortable>AST</th><th data-sortable>+/&ndash;</th>
    {% endif %}
    <th>FG</th><th data-sortable>FG%</th>
    <th>3PT</th><th data-sortable>3P%</th>
    <th>FT</th><th data-sortable>FT%</th>
    <th data-sortable>eFG%</th>
    <th data-sortable>USG%</th>
    <th data-sortable>REB%</th><th data-sortable>AST%</th>
    <th data-sortable>TOV%</th><th data-sortable>FD/40</th>
  </tr>
</thead>
<tbody>
{% for p in players %}
  {% set d = (details or {}).get(p.person_id) %}
  <tr {% if d %}class="expander" data-target="pd-{{ p.person_id }}" tabindex="0"
      role="button" aria-expanded="false"
      aria-controls="pd-{{ p.person_id }}"{% endif %}>
    <td class="left">{{ p.uniform_number or '' }}</td>
    <td class="left name">{% if d %}<span class="twisty" aria-hidden="true">&#9656;</span>{% endif %}{{ p.full_name }}</td>
    {% if per_game %}
      <td>{{ p.games }}</td>
      {{ rk(p.minutes_pg, (pcts or {}).get(p.person_id), 'minutes_pg', pct=True) }}
      {{ rk(p.pts_pg, (pcts or {}).get(p.person_id), 'pts_pg', pct=True) }}
      {{ rk(p.reb_pg, (pcts or {}).get(p.person_id), 'reb_pg', pct=True) }}
      {{ rk(p.ast_pg, (pcts or {}).get(p.person_id), 'ast_pg', pct=True) }}
    {% else %}
      <td>{{ num(p.minutes) }}</td>
      <td>{{ p.PTS }}</td>
      <td>{{ p.REB }}</td>
      <td>{{ p.AS }}</td>
      <td class="{{ tone(p.PM) }}">{{ '%+d'|format(p.PM or 0) }}</td>
    {% endif %}
    <td>{{ p.FGM }}/{{ p.FGA }}</td>
    {{ rk(p.fg_pct, (pcts or {}).get(p.person_id), 'fg_pct', pct=True) }}
    <td>{{ p.FG3M }}/{{ p.FG3A }}</td>
    {{ rk(p.fg3_pct, (pcts or {}).get(p.person_id), 'fg3_pct', pct=True) }}
    <td>{{ p.FTM }}/{{ p.FTA }}</td>
    {{ rk(p.ft_pct, (pcts or {}).get(p.person_id), 'ft_pct', pct=True) }}
    {{ rk(p.efg_pct, (pcts or {}).get(p.person_id), 'efg_pct', pct=True) }}
    {{ rk(p.usage_pct, (pcts or {}).get(p.person_id), 'usage_pct', pct=True) }}
    {{ rk(p.treb_pct, (pcts or {}).get(p.person_id), 'treb_pct', pct=True) }}
    {{ rk(p.ast_pct, (pcts or {}).get(p.person_id), 'ast_pct', pct=True) }}
    {{ rk(p.tov_pct, (pcts or {}).get(p.person_id), 'tov_pct', pct=True) }}
    {{ rk(p.fouls_drawn_per40, (pcts or {}).get(p.person_id), 'fouls_drawn_per40', pct=True) }}
  </tr>
{% endfor %}
</tbody>
</table>
</div>
{% if pcts and pcts.get('_pool') %}
<p class="note">The small figure is a percentile against all
{{ pcts['_pool'].size }} players who have taken the floor in this event, where
100 is the top of the field and 50 is the middle. Hover it for the plain rank.
The shooting percentages are the one exception: they carry a percentile only
once a player has attempted enough shots for it to mean anything, and it is
measured against the others who cleared the same bar rather than the full field,
which is why hovering one shows a smaller denominator. A percentage with no
figure beside it is a thin sample rather than a gap in the data.</p>
{% endif %}
{% if details %}
<p class="note">Click a player for their shot chart and shooting breakdown.</p>
<div class="player-panels">
{% for p in players %}
  {% set d = details.get(p.person_id) %}
  {% if d %}
  <div class="player-panel" id="pd-{{ p.person_id }}" hidden>
    <h3>{{ p.full_name }} &mdash; shooting{% if scope %}, {{ scope }}{% endif %}</h3>
    <div class="detail-inner">
      <div class="detail-chart">{{ d.chart }}</div>
      <div class="detail-stats">
        <table>
          <thead><tr><th class="left">Zone</th><th>M</th><th>A</th><th>FG%</th>
                     <th>Share</th><th>Pts/att</th></tr></thead>
          <tbody>
          {% for z in d.zones if z.attempts %}
            <tr><td class="left">{{ z.zone }}</td><td>{{ z.makes }}</td>
                <td>{{ z.attempts }}</td><td>{{ num(z.fg_pct) }}</td>
                <td>{{ num(z.share_pct) }}</td>
                <td>{{ num(z.points_per_attempt, 2) }}</td></tr>
          {% endfor %}
            <tr class="total"><td class="left">All field goals</td>
              <td>{{ p.FGM }}</td><td>{{ p.FGA }}</td>
              <td>{{ num(p.fg_pct) }}</td><td>&ndash;</td><td>&ndash;</td></tr>
          </tbody>
        </table>
        <p class="note">Free throws {{ p.FTM }}/{{ p.FTA }}
          &middot; eFG {{ num(p.efg_pct) }}% &middot; TS {{ num(p.ts_pct) }}%
          &middot; usage {{ num(p.usage_pct) }}%
          {% if d.attempts == 0 %} &middot; no field goal attempts recorded{% endif %}
        </p>
      </div>
    </div>
  </div>
  {% endif %}
{% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro lineup_table(lineups, caption='', note='') %}
{% if lineups %}
<div class="scroll-x">
<table>
{% if caption %}<caption>{{ caption }}</caption>{% endif %}
<thead>
  <tr>
    <th class="left">Lineup</th><th data-sortable>MIN</th><th data-sortable>Gm</th>
    <th data-sortable>PF</th><th data-sortable>PA</th><th data-sortable>+/&ndash;</th>
  </tr>
</thead>
<tbody>
{% for l in lineups %}
  <tr>
    <td class="left">{% for p in l.players %}{{ p.uniform_number }} {{ p.full_name.split()[-1] }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</td>
    <td>{{ num(l.minutes) }}</td>
    <td>{{ l.games }}</td>
    <td>{{ l.points_for }}</td>
    <td>{{ l.points_against }}</td>
    <td class="{{ tone(l.plus_minus) }}">{{ '%+d'|format(l.plus_minus) }}</td>
  </tr>
{% endfor %}
</tbody>
</table>
</div>
<p class="note">{{ note }}PF and PA are points scored and allowed while that five
was on court. Minutes are the sample each lineup is judged on, so read a large
plus-minus over two minutes as noise.</p>
{% else %}
<p class="note">No lineup met the minimum minutes threshold.</p>
{% endif %}
{% endmacro %}

{# `prefix` selects which side of the ball the ranks come from: '' for shots the
   team took, 'opp_' for shots it allowed. The zone rows carry their own metric
   slugs, so this does not need to know how the keys are spelled. #}
{% macro zone_table(zones, caption='Shooting by zone', ranks=None, prefix='',
                    klass='') %}
<div class="scroll-x">
<table class="{{ klass }}">
<caption>{{ caption }}</caption>
<thead><tr><th class="left">Zone</th><th data-sortable>M</th><th data-sortable>A</th>
<th data-sortable>FG%</th><th data-sortable>Share</th><th data-sortable>Pts/att</th></tr></thead>
<tbody>
{% for z in zones if z.attempts %}
  <tr>
    <td class="left">{{ z.zone }}</td>
    <td>{{ z.makes }}</td>
    <td>{{ z.attempts }}</td>
    {{ rk(z.fg_pct, ranks, prefix ~ z.metric_fg) }}
    {{ rk(z.share_pct, ranks, prefix ~ z.metric_share) }}
    {{ rk(z.points_per_attempt, ranks, prefix ~ z.metric_ppa, 2) }}
  </tr>
{% endfor %}
</tbody>
</table>
</div>
{% endmacro %}

{# The game-sheet version: two teams against each other, no ranks, because one
   game is not a ranking. `four_factor_ranked` is the season-long counterpart. #}
{% macro four_factor_table(team_ff, opp_ff, league, team_label, opp_label) %}
<div class="scroll-x">
<table>
<thead><tr>
  <th class="left">Factor</th><th>{{ team_label }}</th>
  <th>{{ opp_label }}</th><th>Diff</th><th>Event avg</th>
</tr></thead>
<tbody>
{% for key, label, higher in [('efg_pct','eFG%',True), ('tov_pct','TOV%',False), ('oreb_pct','OREB%',True), ('ft_rate','FTA/FGA',True)] %}
  {% set a = team_ff.get(key) %}{% set b = opp_ff.get(key) %}
  {% set d = (a - b) if (a is not none and b is not none) else none %}
  <tr>
    <td class="left">{{ label }} <span class="unit">{{ 'high' if higher else 'low' }} is better</span></td>
    <td>{{ num(a) }}</td>
    <td>{{ num(b) }}</td>
    <td class="{{ tone(d if higher else (-d if d is not none else none)) }}">{{ signed(d) }}</td>
    <td class="muted">{{ num((league or {}).get(key)) }}</td>
  </tr>
{% endfor %}
</tbody>
</table>
</div>
{% endmacro %}


{# Raw box score totals, the format coaches read first. `rows` is a list of
   {code, name, stats, games}; set per_game to divide counting stats by games.
   Percentages always come from the totals, never from averaged percentages. #}
{% macro team_box(rows, per_game=False, caption='') %}
{% set dp = 1 if per_game else 0 %}
<div class="scroll-x">
<table>
{% if caption %}<caption>{{ caption }}</caption>{% endif %}
<thead><tr>
  <th class="left">Team</th><th>PTS</th>
  <th>FG</th><th>FG%</th><th>2PT</th><th>2P%</th><th>3PT</th><th>3P%</th>
  <th>FT</th><th>FT%</th>
  <th>OR</th><th>DR</th><th>REB</th><th>AST</th><th>TO</th><th>STL</th>
  <th>BLK</th><th>PF</th>
</tr></thead>
<tbody>
{% for r in rows %}
  {% set t = r.stats %}
  {% set n = r.games if (per_game and r.games) else 1 %}
  <tr{% if r.highlight %} class="highlight"{% endif %}>
    <td class="left name">{{ flag(r.code) }}{{ r.name }}</td>
    <td>{{ num(t.PTS / n, dp) }}</td>
    <td>{{ num(t.FGM / n, dp) }}/{{ num(t.FGA / n, dp) }}</td>
    <td>{{ num(100 * t.FGM / t.FGA if t.FGA else none) }}</td>
    <td>{{ num(t.FG2M / n, dp) }}/{{ num(t.FG2A / n, dp) }}</td>
    <td>{{ num(100 * t.FG2M / t.FG2A if t.FG2A else none) }}</td>
    <td>{{ num(t.FG3M / n, dp) }}/{{ num(t.FG3A / n, dp) }}</td>
    <td>{{ num(100 * t.FG3M / t.FG3A if t.FG3A else none) }}</td>
    <td>{{ num(t.FTM / n, dp) }}/{{ num(t.FTA / n, dp) }}</td>
    <td>{{ num(100 * t.FTM / t.FTA if t.FTA else none) }}</td>
    <td>{{ num(t.OR / n, dp) }}</td>
    <td>{{ num(t.DR / n, dp) }}</td>
    <td>{{ num(t.REB / n, dp) }}</td>
    <td>{{ num(t.AS / n, dp) }}</td>
    <td>{{ num(t.TO / n, dp) }}</td>
    <td>{{ num(t.ST / n, dp) }}</td>
    <td>{{ num(t.BS / n, dp) }}</td>
    <td>{{ num(t.PF / n, dp) }}</td>
  </tr>
{% endfor %}
</tbody>
</table>
</div>
{% endmacro %}


{# Scoring categories as a share of each team's points. They overlap, so they
   do not sum to 100 and the caller says so. #}
{# Each row carries `metric`, the rank key for the team's own line; the second
   row of a scouting page is that team's opponents, so its rows prefix with
   'opp_'. Ranks are per game, which is why they are withheld on a game sheet,
   where `ranks` is never passed. #}
{% macro scoring_share(rows, per_game=False, caption='Scoring breakdown',
                       ranks=None, table_id='') %}
{% set dp = 1 if per_game else 0 %}
{% if ranks and table_id %}{{ rank_toggle('#' ~ table_id) }}{% endif %}
<div class="scroll-x">
<table {% if table_id %}id="{{ table_id }}"{% endif %}>
{% if caption %}<caption>{{ caption }}</caption>{% endif %}
<thead><tr>
  <th class="left">Category</th>
  {% for r in rows %}<th>{{ r.code }}</th><th>% of pts</th>{% endfor %}
</tr></thead>
<tbody>
{% for label, key, metric in [('Points in paint','A_PIP','pip'),
                              ('Fast break','A_FBP','fbp'),
                              ('Second chance','A_SCP','scp'),
                              ('Off turnovers','A_PAT','pat'),
                              ('From the bench','A_PFB','bench')] %}
  <tr>
    <td class="left">{{ label }}</td>
    {% for r in rows %}
      {% set v = r.stats[key] or 0 %}{% set n = r.games if r.games else 1 %}
      {{ rk(v / n, ranks, (r.metric_prefix or '') ~ metric, dp) }}
      <td class="muted">{{ num(100 * v / r.stats.PTS if r.stats.PTS else none) }}%</td>
    {% endfor %}
  </tr>
{% endfor %}
  <tr class="total">
    <td class="left">Total points</td>
    {% for r in rows %}
      <td>{{ num(r.stats.PTS / (r.games if r.games else 1), dp) }}</td>
      <td class="muted">&ndash;</td>
    {% endfor %}
  </tr>
</tbody>
</table>
</div>
<p class="note">These categories overlap and do not sum to the total: a
fast-break layup counts as points in the paint too, and bench points cut across
all of them.</p>
{% endmacro %}


{# Game log with both halves of the four factors, behind the same
   Offence / Defence / Combined toggle the leaderboard uses. Every row links to
   that game's sheet, which exists for every game in the event, not just
   Ireland's. #}
{% macro game_log(games, table_id='gamelog', totals=None, total_label='Tournament') %}
<div class="viewtoggle no-print" data-target="#{{ table_id }}">
  <button type="button" data-view="off" aria-pressed="false">Offence</button>
  <button type="button" data-view="def" aria-pressed="false">Defence</button>
  <button type="button" data-view="all" aria-pressed="true">Combined</button>
</div>
<div class="scroll-x">
<table id="{{ table_id }}" class="view-all">
<thead><tr>
  <th class="left" data-sortable>Opponent</th>
  <th class="left" data-sortable>Result</th>
  <th data-sortable>Poss</th>
  <th class="c-off" data-sortable>eFG%</th>
  <th class="c-off" data-sortable>TOV%</th>
  <th class="c-off" data-sortable>OREB%</th>
  <th class="c-off" data-sortable>FTA/FGA</th>
  <th class="c-off" data-sortable>ORtg</th>
  <th class="c-def" data-sortable>Opp eFG%</th>
  <th class="c-def" data-sortable>TOV% frc</th>
  <th class="c-def" data-sortable>DREB%</th>
  <th class="c-def" data-sortable>Opp FTr</th>
  <th class="c-def" data-sortable>DRtg</th>
  <th data-sortable>Net/100</th>
</tr></thead>
<tbody>
{% for g in games %}
  {% set o = g.four_factors %}{% set d = g.opp_four_factors %}
  <tr>
    <td class="left name">{{ flag(g.opponent_identity.code) }}{% if g.review_href %}<a href="{{ g.review_href }}">{{ g.opponent_identity.name }}</a>{% else %}{{ g.opponent_identity.name }}{% endif %}</td>
    <td class="left {{ 'pos' if g.won else 'neg' }}"
        data-value="{{ (g.score or 0) - (g.opp_score or 0) }}">
      {{ 'W' if g.won else 'L' }} {{ g.score }}&ndash;{{ g.opp_score }}</td>
    <td>{{ num(o.possessions, 0) }}</td>
    <td class="c-off">{{ num(o.efg_pct) }}</td>
    <td class="c-off">{{ num(o.tov_pct) }}</td>
    <td class="c-off">{{ num(o.oreb_pct) }}</td>
    <td class="c-off">{{ num(o.ft_rate) }}</td>
    <td class="c-off">{{ num(o.off_rating) }}</td>
    <td class="c-def">{{ num(d.efg_pct) }}</td>
    <td class="c-def">{{ num(d.tov_pct) }}</td>
    <td class="c-def">{{ num(o.dreb_pct) }}</td>
    <td class="c-def">{{ num(d.ft_rate) }}</td>
    <td class="c-def">{{ num(o.def_rating) }}</td>
    <td class="{{ tone(o.net_rating) }}">{{ signed(o.net_rating) }}</td>
  </tr>
{% endfor %}
{% if totals %}
  <tr class="total">
    <td class="left">{{ total_label }}</td>
    <td class="left">{{ totals.record }}</td>
    <td>{{ num(totals.pace, 0) }}</td>
    <td class="c-off">{{ num(totals.own.efg_pct) }}</td>
    <td class="c-off">{{ num(totals.own.tov_pct) }}</td>
    <td class="c-off">{{ num(totals.own.oreb_pct) }}</td>
    <td class="c-off">{{ num(totals.own.ft_rate) }}</td>
    <td class="c-off">{{ num(totals.own.off_rating) }}</td>
    <td class="c-def">{{ num(totals.opp.efg_pct) }}</td>
    <td class="c-def">{{ num(totals.opp.tov_pct) }}</td>
    <td class="c-def">{{ num(totals.own.dreb_pct) }}</td>
    <td class="c-def">{{ num(totals.opp.ft_rate) }}</td>
    <td class="c-def">{{ num(totals.own.def_rating) }}</td>
    <td class="{{ tone(totals.own.net_rating) }}">{{ signed(totals.own.net_rating) }}</td>
  </tr>
{% endif %}
</tbody>
</table>
</div>
<p class="note">Click an opponent to open that game's sheet. Defensive columns
describe what this team allowed: Opp eFG% and Opp FTr are lower-is-better,
TOV% forced and DREB% are higher-is-better.</p>
{% endmacro %}


{# Four factors on both sides of the ball, each ranked against the event. The
   game sheet keeps the simpler team-versus-team table above; this one is for
   pages where a team has a season to be ranked within. #}
{% macro four_factor_ranked(own, opp, league, ranks, code, table_id='ff') %}
{{ rank_toggle('#' ~ table_id) }}
<div class="scroll-x">
<table id="{{ table_id }}">
<thead><tr>
  <th class="left">Factor</th><th>{{ code }}</th><th>Event avg</th>
</tr></thead>
<tbody>
  <tr class="subhead"><td class="left" colspan="3">Offence</td></tr>
  {% for key, label, hint, src in [
      ('efg_pct','eFG%','high is better', own),
      ('tov_pct','TOV%','low is better', own),
      ('oreb_pct','OREB%','high is better', own),
      ('ft_rate','FTA/FGA','high is better', own)] %}
  <tr>
    <td class="left">{{ label }} <span class="unit">{{ hint }}</span></td>
    {{ rk(src.get(key), ranks, key) }}
    <td class="muted">{{ num((league or {}).get(key)) }}</td>
  </tr>
  {% endfor %}
  <tr class="subhead"><td class="left" colspan="3">Defence, what they allow</td></tr>
  {% for key, label, hint, value, avg in [
      ('opp_efg_pct','Opp eFG%','low is better', opp.get('efg_pct'), (league or {}).get('efg_pct')),
      ('tov_forced_pct','TOV% forced','high is better', opp.get('tov_pct'), (league or {}).get('tov_pct')),
      ('dreb_pct','DREB%','high is better', own.get('dreb_pct'), (league or {}).get('dreb_pct')),
      ('opp_ft_rate','Opp FTA/FGA','low is better', opp.get('ft_rate'), (league or {}).get('ft_rate'))] %}
  <tr>
    <td class="left">{{ label }} <span class="unit">{{ hint }}</span></td>
    {{ rk(value, ranks, key) }}
    <td class="muted">{{ num(avg) }}</td>
  </tr>
  {% endfor %}
</tbody>
</table>
</div>
{% endmacro %}


{# Like rk() but for tables whose columns belong to a switchable view group. #}
{% macro rk_cell(value, ranks, key, digits=1, plus=False, klass='') -%}
{%- set r = (ranks or {}).get(key) -%}
<td class="{{ klass }}{% if r and r.tier %} t{{ r.tier }}{% endif %}">
{%- if plus %}{{ signed(value, digits) }}{% else %}{{ num(value, digits) }}{% endif -%}
{%- if r %}<span class="rk-chip">{{ ordinal_short(r.rank) }}</span>{% endif -%}
</td>
{%- endmacro %}

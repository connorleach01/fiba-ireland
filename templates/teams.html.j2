{% extends "_base.html.j2" %}
{% import "_macros.j2" as m %}

{% block title %}Team leaderboard{% endblock %}
{% block eyebrow %}{{ event_name }} &middot; Team leaderboard{% endblock %}
{% block heading %}All teams, ranked{% endblock %}
{% block subtitle %}
{{ rows|length }} teams &middot; {{ games_played }} games played &middot;
Switch view, click a column to sort, turn on ranks to shade
{% endblock %}
{% block footid %}Team leaderboard{% endblock %}

{% block content %}

<section>
<h2>Leaderboard</h2>

<div class="viewtoggle no-print" data-target="#leaderboard">
  {% for g in groups %}
  <button type="button" data-view="{{ g.key }}"
          aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ g.label }}</button>
  {% endfor %}
</div>
{{ m.rank_toggle('#leaderboard') }}

<div class="scroll-x">
<table id="leaderboard" class="view-adv show-ranks" data-rank-column="0">
<thead>
  <tr>
    <th class="left">#</th>
    <th class="left" data-sortable>Team</th>
    <th data-sortable>Gm</th>
    <th data-sortable>W&ndash;L</th>
    {% for g in groups %}
      {% for metric in g.metrics %}
        <th class="c-{{ g.key }}" data-sortable>{{ metric.label }}</th>
      {% endfor %}
    {% endfor %}
  </tr>
</thead>
<tbody>
{% for r in rows %}
  <tr{% if r.highlight %} class="highlight"{% endif %}>
    <td class="left muted">{{ loop.index }}</td>
    <td class="left name">{{ flag(r.identity.code) }}{{ r.identity.name }}</td>
    <td>{{ r.games }}</td>
    <td data-value="{{ '%.4f'|format(r.win_pct) }}">{{ r.wins }}&ndash;{{ r.losses }}</td>
    {% for g in groups %}
      {% for metric in g.metrics %}
        {{ m.rk_cell(r.stats.get(metric.key), r.ranks, metric.key,
                     metric.dp, metric.plus, 'c-' ~ g.key) }}
      {% endfor %}
    {% endfor %}
  </tr>
{% endfor %}
</tbody>
</table>
</div>
<p class="note">Ranked by net rating. Every view covers both sides of the ball:
the columns prefixed <strong>Opp</strong> are what a team allows, and shading
already accounts for direction, so a shaded cell is good or bad rather than just
high or low. Pace and the shot-share columns carry a rank but no shading, because
taking a lot of threes is a style rather than an achievement. Teams enter the
tournament having played different numbers of games; the Gm column shows the
sample behind each row.</p>
</section>

{% endblock %}

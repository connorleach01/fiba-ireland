{% extends "_base.html.j2" %}
{% import "_macros.j2" as m %}

{% block title %}{{ us.code }} v {{ them.code }} game review{% endblock %}
{% block eyebrow %}{{ event_name }} &middot; Game review{% endblock %}
{% block kickerright %}{{ played_at }}{% endblock %}
{% block heading %}{{ flag(us.code, 24) }}{{ us.name }} {{ score }}&ndash;{{ opp_score }} {{ them.name }}<span class="flag-wrap">{{ flag(them.code, 24) }}</span>{% endblock %}
{% block subtitle %}
{{ 'Win' if won else 'Loss' }}{% if venue %} &middot; {{ venue }}{% endif %} &middot;
{{ '%.0f'|format(ff.possessions or 0) }} possessions
&middot; Net {{ '%+.1f'|format(ff.net_rating or 0) }} per 100
{% endblock %}
{% block footid %}{{ us.code }} v {{ them.code }} game review{% endblock %}

{% block content %}

<section class="keep">
<h2>Result</h2>
<div class="statline">
  {{ m.stat('Final', '%d&ndash;%d'|format(score, opp_score), 'Win' if won else 'Loss',
            'pos' if won else 'neg') }}
  {{ m.stat('Off rating', '%.1f'|format(ff.off_rating or 0), 'points / 100 poss') }}
  {{ m.stat('Def rating', '%.1f'|format(ff.def_rating or 0), 'allowed / 100 poss') }}
  {{ m.stat('Net', '%+.1f'|format(ff.net_rating or 0), 'per 100 poss',
            'pos' if (ff.net_rating or 0) > 0 else 'neg') }}
  {{ m.stat('Pace', '%.0f'|format(ff.possessions or 0),
            'event avg %.0f'|format(league.pace or 0)) }}
</div>

<div class="cols" style="margin-top:10px">
  <div>
    <table>
      <caption>Score by period</caption>
      <thead><tr><th class="left">Team</th>{% for q in periods %}<th>{{ q }}</th>{% endfor %}<th>Final</th></tr></thead>
      <tbody>
        <tr class="highlight"><td class="left">{{ flag(us.code) }}{{ us.code }}</td>
          {% for q in periods %}<td>{{ our_periods.get(q, '') }}</td>{% endfor %}
          <td>{{ score }}</td></tr>
        <tr><td class="left">{{ flag(them.code) }}{{ them.code }}</td>
          {% for q in periods %}<td>{{ their_periods.get(q, '') }}</td>{% endfor %}
          <td>{{ opp_score }}</td></tr>
      </tbody>
    </table>
  </div>
  <div>
    {{ m.scoring_share(box_rows) }}
  </div>
</div>
</section>

<section>
<h2>Team box score</h2>
{{ m.team_box(box_rows) }}
</section>

<section class="keep">
<h2>Four factors</h2>
{{ m.four_factor_table(ff, off, league, us.code, them.code) }}
{{ charts.four_factors }}
<p class="note">Bars are {{ us.code }} against what {{ us.code }} allowed. The
vertical rule marks the competition average for that factor.</p>
</section>

<section class="keep">
<h2>How the game moved</h2>
{{ charts.timeline }}
</section>

<section class="keep">
<h2>Shooting</h2>
<div class="chartpair">
  <div>
    <h3>Shots {{ us.name }} took</h3>
    {{ charts.shots }}
  </div>
  <div>
    <h3>Shots {{ us.name }} allowed</h3>
    {{ charts.shots_faced }}
  </div>
</div>
</section>

<section>
<h2>Shooting by zone</h2>
<div class="cols">
  <div>{{ m.zone_table(zones, caption='Shots ' ~ us.name ~ ' took') }}</div>
  <div>{{ m.zone_table(faced_zones, caption='Shots ' ~ us.name ~ ' allowed') }}</div>
</div>
</section>

<section>
<h2>Box score &mdash; {{ us.name }}</h2>
{{ m.player_table(players, per_game=False, details=player_details,
                  scope='this game') }}
<p class="note">USG% is the share of team possessions used while on court.
FD/40 is fouls drawn per 40 minutes. Click any player for their shot chart, zone
splits and true shooting.</p>
</section>

<section>
<h2>Lineups</h2>
{% if lineups_available %}
{{ m.lineup_table(lineups, 'Five-man units, at least 90 seconds together') }}
{% else %}
<p class="banner alert">Lineup reconstruction did not pass validation for this
game, so lineup and on/off figures are withheld rather than shown unverified.</p>
{% endif %}
</section>

{% endblock %}

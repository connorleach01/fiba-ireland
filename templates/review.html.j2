{% extends "_base.html.j2" %}
{% import "_macros.j2" as m %}

{% block title %}{{ home.identity.code }} v {{ away.identity.code }} game sheet{% endblock %}
{% block eyebrow %}{{ event_name }} &middot; Game sheet{% endblock %}
{% block kickerright %}{{ played_at }}{% endblock %}
{% block heading %}{{ flag(home.identity.code, 24) }}{{ home.identity.name }}
{{ home.score }}&ndash;{{ away.score }} {{ away.identity.name }}{{ flag(away.identity.code, 24) }}{% endblock %}
{% block subtitle %}
{% if venue %}{{ venue }} &middot; {% endif %}
{{ '%.0f'|format(ff.possessions or 0) }} possessions &middot;
{{ home.identity.code }} net {{ '%+.1f'|format(ff.net_rating or 0) }} per 100
{% endblock %}
{% block footid %}{{ home.identity.code }} v {{ away.identity.code }} game sheet{% endblock %}

{% block content %}

<section class="keep">
<h2>Result</h2>
<div class="statline">
  {{ m.stat('Final', '%d&ndash;%d'|format(home.score, away.score),
            (home.identity.name ~ ' win') if home.won else (away.identity.name ~ ' win'),
            'pos' if home.won else 'neg') }}
  {{ m.stat(home.identity.code ~ ' off rating', '%.1f'|format(ff.off_rating or 0),
            'points / 100 poss') }}
  {{ m.stat(away.identity.code ~ ' off rating', '%.1f'|format(off.off_rating or 0),
            'points / 100 poss') }}
  {{ m.stat('Pace', '%.0f'|format(ff.possessions or 0),
            'event avg %.0f'|format(league.pace or 0)) }}
</div>

<div class="cols" style="margin-top:10px">
  <div>
    <table>
      <caption>Score by period</caption>
      <thead><tr><th class="left">Team</th>{% for q in periods %}<th>{{ q }}</th>{% endfor %}<th>Final</th></tr></thead>
      <tbody>
        <tr class="highlight"><td class="left">{{ flag(home.identity.code) }}{{ home.identity.code }}</td>
          {% for q in periods %}<td>{{ our_periods.get(q, '') }}</td>{% endfor %}
          <td>{{ home.score }}</td></tr>
        <tr><td class="left">{{ flag(away.identity.code) }}{{ away.identity.code }}</td>
          {% for q in periods %}<td>{{ their_periods.get(q, '') }}</td>{% endfor %}
          <td>{{ away.score }}</td></tr>
      </tbody>
    </table>
  </div>
  <div>
    {{ m.scoring_share(box_rows) }}
  </div>
</div>
</section>

<section>
<h2>Team box score</h2>
{{ m.team_box(box_rows) }}
</section>

<section class="keep">
<h2>Four factors</h2>
{{ m.four_factor_table(ff, off, league, home.identity.code, away.identity.code) }}
{{ charts.four_factors }}
<p class="note">Shown from {{ home.identity.name }}'s side: their four factors
against what they allowed. The vertical rule marks the competition average.</p>
</section>

<section class="keep">
<h2>How the game moved</h2>
{{ charts.timeline }}
</section>

<section class="keep">
<h2>Shooting</h2>
<div class="chartpair">
  <div>
    <h3>Shots {{ home.identity.name }} took</h3>
    {{ home.chart }}
    {{ m.zone_table(home.zones, caption='') }}
  </div>
  <div>
    <h3>Shots {{ away.identity.name }} took</h3>
    {{ away.chart }}
    {{ m.zone_table(away.zones, caption='') }}
  </div>
</div>
</section>

{% for side in [home, away] %}
<section>
<h2>Box score &mdash; {{ side.identity.name }}</h2>
{# One id per table: both sides appear on the same page, and the sort handler
   finds a table by id. #}
{{ m.player_table(side.players, per_game=False, details=side.details,
                  scope='this game', table_id='box-' ~ side.identity.code) }}
{% if loop.first %}
<p class="note">USG% is the share of team possessions used while on court.
FD/40 is fouls drawn per 40 minutes.</p>
{% endif %}
</section>
{% endfor %}

<section>
<h2>Lineups</h2>
{% if lineups_available %}
<div class="cols">
  <div>
    <h3>{{ home.identity.name }}</h3>
    {{ m.lineup_table(home.lineups) }}
  </div>
  <div>
    <h3>{{ away.identity.name }}</h3>
    {{ m.lineup_table(away.lineups) }}
  </div>
</div>
{% else %}
<p class="banner alert">Lineup reconstruction did not pass validation for this
game, so lineup figures are withheld rather than shown unverified.</p>
{% endif %}
</section>

{% endblock %}

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the poller in the background and restarts it if it dies or the Mac reboots.

  Install:
      cp com.fiba.ireland.watch.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.fiba.ireland.watch.plist

  Stop:
      launchctl unload ~/Library/LaunchAgents/com.fiba.ireland.watch.plist

  Watch the log:
      tail -f ~/code/fiba-ireland/data/watch.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fiba.ireland.watch</string>

  <!--
    No `caffeinate` wrapper here on purpose. The poller holds the sleep assertion
    itself, and only inside a result window, so the Mac is free to sleep through
    the 12 hours overnight and the 22 to 36 hours of a rest day. Wrapping the
    whole agent would pin the machine awake around the clock to buy nothing.

    Sleeping does not lose games, it only delays them: the trigger is "VALID and
    not yet scraped", not "finished since the last poll", so the first poll after
    waking ingests everything that landed in the gap.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/connorleach/code/fiba-ireland/.venv/bin/python</string>
    <string>-m</string>
    <string>fiba.watch</string>
  </array>
  <!--
    No --interval on purpose: that flag pins the gap and disables adaptive
    polling, which is the thing that gets a report out seconds after the buzzer
    rather than minutes. The poller works its own cadence out from the tip times
    in the schedule.
  -->


  <key>WorkingDirectory</key>
  <string>/Users/connorleach/code/fiba-ireland</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if the process exits for any reason, with a pause so a persistent
       failure does not spin. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/Users/connorleach/code/fiba-ireland/data/watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/connorleach/code/fiba-ireland/data/watch.log</string>
</dict>
</plist>

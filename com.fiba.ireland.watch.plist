<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the poller in the background and restarts it if it dies or the Mac reboots.

  Install:
      cp com.fiba.ireland.watch.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.fiba.ireland.watch.plist

  Stop:
      launchctl unload ~/Library/LaunchAgents/com.fiba.ireland.watch.plist

  Watch the log:
      tail -f ~/code/fiba-ireland/data/watch.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fiba.ireland.watch</string>

  <!--
    Wrapped in `caffeinate -s` because this Mac sleeps after a minute idle, and a
    sleeping Mac polls nothing. `-s` holds off system sleep only while on AC
    power, so unplugged the machine still sleeps normally and the battery is
    safe. The assertion lives and dies with the agent: unload it and the Mac
    sleeps as before.

    Sleeping does not lose games, it only delays them. On wake the next poll
    ingests every game that went final in the meantime, because the trigger is
    "VALID and not yet scraped", not "finished since the last poll". Closing the
    lid still sleeps the machine whatever this says.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>/Users/connorleach/code/fiba-ireland/.venv/bin/python</string>
    <string>-m</string>
    <string>fiba.watch</string>
    <string>--interval</string>
    <string>300</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/connorleach/code/fiba-ireland</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if the process exits for any reason, with a pause so a persistent
       failure does not spin. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/Users/connorleach/code/fiba-ireland/data/watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/connorleach/code/fiba-ireland/data/watch.log</string>
</dict>
</plist>
